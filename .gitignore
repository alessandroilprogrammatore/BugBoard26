# =============================================
# BugBoard26 - .gitignore
# =============================================

# ---------- Logs ----------
logs/
*.log
*.err.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Dependencies ----------
node_modules/
dist/
dist-ssr/
*.local

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml

# ---------- Maven / Backend ----------
backend/target/
backend/data/
backend/*.iml

# ---------- LaTeX (sorgenti, il PDF compilato resta) ----------
*.tex
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.mmd
!Documentazione/Secondo homework/diagrammi/*.mmd

# ---------- OS ----------
Thumbs.db
desktop.ini
ehthumbs.db

# ---------- Binary lock files ----------
bun.lockb

# ---------- Temp / debug / utility scripts ----------
*.mjs
*.py
p.txt
pdf_output.txt
mvn_output.txt
student_pdf_output.txt
_temp_*.html
debug_*.png
tmp_*.png
verify_*.png

# ---------- Video / recording / tutorial assets ----------
generated_*
gemini_*
tutorial_*
tutorial_screenshots/
tutorial_scripts/
frame_*
**/immagini/frame_*
**/immagini/screenshot_*
**/immagini/tutorial_*
*.mp4
*.webm
*.avi

# ---------- Environment ----------
.env
.env.*
!.env.example

# ---------- Misc ----------
*.zip
*.pptx
.claude/
