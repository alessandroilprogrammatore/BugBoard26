# Produzione HTTPS con docker-compose.cloud.yml
# Sostituisci i valori di esempio prima del deploy reale.

APP_DOMAIN=bugboard.example.com
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
POSTGRES_USER=bugboard
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=bugboard

# Opzionale: abilita Swagger solo temporaneamente su ambienti non pubblici.
APP_SECURITY_EXPOSE_DOCS=false

# Non modificare salvo esigenze particolari.
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=Lax
SPRING_JPA_HIBERNATE_DDL_AUTO=update
